# Copy this file to .env and fill in your values. Never commit .env.

# LLM backend: "gemini" (default), "antigravity", or "mock"
TRIAGE_BACKEND=gemini

# Required when TRIAGE_BACKEND=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Gmail OAuth2 desktop client credentials and cached token paths
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# Agent behavior defaults
TRIAGE_MAX_EMAILS=10
TRIAGE_DRY_RUN=false

